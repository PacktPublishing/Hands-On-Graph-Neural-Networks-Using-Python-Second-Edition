#!/bin/sh
# Keep each chapter's generated files in step with its sources.
#
# run.py is the single source of truth for the notebook; run.py,
# requirements.txt and figures/ are the sources for the derived blocks of the
# README. When a commit touches one of those, the generated file is refreshed
# and added to the same commit, so the two can never be committed out of step.
#
# A staged requirements.txt is also checked against the pinned root set before
# anything is regenerated, because a floor that is too low never conflicts with
# anything: without the check, one package can quietly end up stated two ways.
#
# READMEs are only *synced*, never regenerated: several chapters have a
# hand-written README (Neo4j setup, expected results, caveats) and rewriting
# those would throw that away. The sync touches the requirements list and the
# figure count, and only where the generated block is already there.
#
# Installed by tools/install_hooks.sh. Skip it once with: git commit --no-verify

set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only --diff-filter=ACMRD)

notebooks=$(echo "$staged" | sed -n 's#^Chapter\([0-9][0-9]\)/run\.py$#\1#p')
readmes=$(echo "$staged" \
    | sed -n -e 's#^Chapter\([0-9][0-9]\)/run\.py$#\1#p' \
             -e 's#^Chapter\([0-9][0-9]\)/requirements\.txt$#\1#p' \
             -e 's#^Chapter\([0-9][0-9]\)/figures/.*\.png$#\1#p' \
    | sort -u)

reqs=$(echo "$staged" | sed -n -e 's#^requirements\.txt$#&#p' \
                            -e 's#^Chapter[0-9][0-9]/requirements\.txt$#&#p')

[ -z "$notebooks" ] && [ -z "$readmes" ] && [ -z "$reqs" ] && exit 0

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 non trovato, file generati non aggiornati" >&2
    exit 1
fi

# Conflicts and drift refuse the commit; the warnings about the four
# deliberately locked packages do not.
if [ -n "$reqs" ]; then
    if ! report=$(python3 tools/check_requirements.py 2>&1); then
        printf '%s\n' "$report" >&2
        echo "pre-commit: requirements incoerenti, commit annullato" >&2
        exit 1
    fi
fi

changed=""

# Stage a generated file only if regenerating actually changed it, so the
# hook never claims to have rewritten something it left alone.
stage_if_changed() {
    [ -f "$1" ] || return 0
    git diff --quiet -- "$1" && return 0
    git add "$1"
    changed="$changed $1"
}

if [ -n "$notebooks" ]; then
    python3 tools/make_notebooks.py --only $notebooks >/dev/null
    for n in $notebooks; do
        stage_if_changed "Chapter$n/Chapter$n.ipynb"
    done
fi

if [ -n "$readmes" ]; then
    python3 tools/make_chapter_readme.py --sync --only $readmes >/dev/null
    for n in $readmes; do
        stage_if_changed "Chapter$n/README.md"
    done
fi

[ -n "$changed" ] && echo "pre-commit: rigenerati e aggiunti al commit —$changed"
exit 0
